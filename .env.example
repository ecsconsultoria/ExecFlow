# Copy this file to .env and fill in the values
SECRET_KEY=change-me-in-production
FLASK_ENV=development

# Database (leave blank for SQLite dev)
DATABASE_URL=sqlite:///DB_V2.db

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SENDER_NAME=Executive Car SP
EMAIL_ADMIN=admin@executivecarsp.com

# App
BASE_URL=http://localhost:5004
WPP_NUMBER=5511989178312

# PIX
PIX_KEY=your-pix-key
PIX_MERCHANT_NAME=Executive Car SP
PIX_MERCHANT_CITY=Sao Paulo

# Tax rates (decimal)
NF_RATE=0.10
CARD_RATE=0.065

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
